---
import BaseHead from "../components/BaseHead.astro";
import Header, { type Breadcrumb } from "../components/Header.astro";

interface Props {
  title: string;
  description: string;
  breadcrumbs: Breadcrumb[];
  /** ヘッダーとフッターの内容幅。ページ側と揃えるために渡す */
  maxWidthClass?: string;
}

const {
  title,
  description,
  breadcrumbs,
  maxWidthClass = "max-w-2xl",
} = Astro.props;
---

<html lang="ja">
  <head>
    <BaseHead title={title} description={description} />
  </head>
  <!-- ヘッダーとフッターは内容ぶんの高さを取り、残りをすべて本文に渡す。
       ページ自体はスクロールさせず、地図が常に画面に収まる状態を保つ -->
  <body class="grid h-dvh grid-rows-[auto_1fr_auto] overflow-hidden">
    <Header breadcrumbs={breadcrumbs} maxWidthClass={maxWidthClass} />
    <slot />
  </body>
</html>
