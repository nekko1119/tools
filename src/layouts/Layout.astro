---
import BaseHead from "../components/BaseHead.astro";
import Header, { type Breadcrumb } from "../components/Header.astro";

interface Props {
  title: string;
  description: string;
  breadcrumbs: Breadcrumb[];
  /** ヘッダーの内容幅。ページ本体の max-width と揃えるために渡す */
  maxWidthClass?: string;
}

const {
  title,
  description,
  breadcrumbs,
  maxWidthClass = "max-w-2xl",
} = Astro.props;
---

<html lang="ja">
  <head>
    <BaseHead title={title} description={description} />
  </head>
  <body>
    <Header breadcrumbs={breadcrumbs} maxWidthClass={maxWidthClass} />
    <slot />
  </body>
</html>
