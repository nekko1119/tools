---
import LinkCardGrid from "../../components/LinkCardGrid.astro";
import Layout from "../../layouts/Layout.astro";

const base = import.meta.env.BASE_URL;

const links = [
  {
    href: `${base}nightreign/nightlord-quiz/`,
    title: "標的不明クイズ",
    description: "ヒントから夜の王を当てるクイズ",
  },
  {
    href: `${base}nightreign/maps/`,
    title: "拠点地図",
    description: "攻略拠点の地図",
  },
];
---

<Layout
  title="Nightreign - Tools"
  description="ELDEN RING NIGHTREIGN 関連のツール一覧。"
  breadcrumbs={[{ label: "ツール類", href: base }, { label: "Nightreign" }]}
>
  <main class="container mx-auto p-4 max-w-2xl min-w-80">
    <h1 class="text-3xl font-bold mb-6">Nightreign</h1>

    <LinkCardGrid cards={links} />
  </main>
</Layout>
