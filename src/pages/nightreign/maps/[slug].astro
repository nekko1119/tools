---
import type { GetStaticPaths } from "astro";
import MapView from "../../../components/MapView.astro";
import { nightreignMapItemTypes } from "../../../data/nightreign-map-item-types";
import { nightreignMaps } from "../../../data/nightreign-maps";
import DisclaimerFooter from "../../../components/DisclaimerFooter.astro";
import MapLayout from "../../../layouts/MapLayout.astro";
import { loadMapItemPlacement } from "../../../lib/nightreign/map-items";
import {
  loadTranslations,
  translate,
} from "../../../lib/nightreign/translations";

export const getStaticPaths = (() =>
  nightreignMaps.map((location) => ({
    params: { slug: location.slug },
    props: { location },
  }))) satisfies GetStaticPaths;

const { location } = Astro.props;

const base = import.meta.env.BASE_URL;
const translations = loadTranslations();
const locationName = translate(translations, location.englishName);

const placement = loadMapItemPlacement(location, nightreignMapItemTypes);

// 地図が横長のため、ヘッダーとフッターを既定より広くする
const maxWidthClass = "max-w-7xl";
---

<MapLayout
  title={`${locationName} - 拠点地図 - Nightreign`}
  description={`ELDEN RING NIGHTREIGN の${locationName}の地図。`}
  breadcrumbs={[
    { label: "ツール類", href: base },
    { label: "Nightreign", href: `${base}nightreign/` },
    { label: "拠点地図", href: `${base}nightreign/maps/` },
    { label: locationName },
  ]}
  maxWidthClass={maxWidthClass}
>
  <!-- 地図は画面の端まで使うため、ヘッダーやフッターと違い幅を絞らない -->
  <main class="min-h-0">
    <MapView
      location={location}
      mapName={locationName}
      patterns={placement.patterns}
      itemTypes={nightreignMapItemTypes}
    />
  </main>
  <DisclaimerFooter maxWidthClass={maxWidthClass} />
</MapLayout>
