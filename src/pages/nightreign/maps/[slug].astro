---
import type { GetStaticPaths } from "astro";
import MapFloorSwitch from "../../../components/MapFloorSwitch.astro";
import { nightreignMapItemTypes } from "../../../data/nightreign-map-item-types";
import { nightreignMaps } from "../../../data/nightreign-maps";
import Layout from "../../../layouts/Layout.astro";
import { formatMapTypeLabel } from "../../../lib/nightreign/map";
import { loadMapItemPlacement } from "../../../lib/nightreign/map-items";
import {
  loadTranslations,
  translate,
} from "../../../lib/nightreign/translations";

export const getStaticPaths = (() =>
  nightreignMaps.map((location) => ({
    params: { slug: location.slug },
    props: { location },
  }))) satisfies GetStaticPaths;

const { location } = Astro.props;

const base = import.meta.env.BASE_URL;
const translations = loadTranslations();
const locationName = translate(translations, location.englishName);

const placement = loadMapItemPlacement(
  location,
  nightreignMapItemTypes.map((itemType) => itemType.id),
);

// タイプが1つしかない拠点では見出しを出さず、地図だけを表示する
const hasMultipleTypes = location.types.length > 1;

// 地図が横長のため、ヘッダーと本文をまとめて既定より広くする
const maxWidthClass = "max-w-5xl";
---

<Layout
  title={`${locationName} - 拠点地図 - Nightreign`}
  description={`ELDEN RING NIGHTREIGN の${locationName}の地図。`}
  breadcrumbs={[
    { label: "ツール類", href: base },
    { label: "Nightreign", href: `${base}nightreign/` },
    { label: "拠点地図", href: `${base}nightreign/maps/` },
    { label: locationName },
  ]}
  maxWidthClass={maxWidthClass}
>
  <main class:list={["container mx-auto p-4 min-w-80", maxWidthClass]}>
    <h1 class="text-2xl font-bold mb-6">{locationName}</h1>

    {
      location.types.map((type) => (
        <section class="mb-8">
          {hasMultipleTypes && (
            <h2 class="text-lg font-bold mb-3">{formatMapTypeLabel(type)}</h2>
          )}
          <MapFloorSwitch
            switchId={`floor-${location.slug}-${type.id}`}
            type={type}
            mapName={
              hasMultipleTypes
                ? `${locationName} ${formatMapTypeLabel(type)}`
                : locationName
            }
            patterns={placement.patternsByTypeId[type.id] ?? []}
            itemTypes={nightreignMapItemTypes}
          />
        </section>
      ))
    }
  </main>
  <footer
    class:list={[
      "container mx-auto p-4 mt-8 border-t border-base-300",
      maxWidthClass,
    ]}
  >
    <p class="text-xs text-base-content/50">
      ※ 掲載データの正確性を保証するものではありません。
    </p>
  </footer>
</Layout>
