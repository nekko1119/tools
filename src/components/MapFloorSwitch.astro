---
import { getImage, Image } from "astro:assets";
import type { MapType } from "../types/nightreign-map";
import type { MapItemPattern } from "../types/nightreign-map-item";
import MapItemIcon from "./MapItemIcon.astro";

interface Props {
  /** radio のグループ名とidを一意にするための識別子 */
  switchId: string;
  type: MapType;
  /** 画像の alt の先頭に付ける名前。例: "大教会" */
  mapName: string;
  /** このタイプに属するアイテム配置パターン。未定義の拠点では空になる */
  patterns: readonly MapItemPattern[];
  /** 最初に表示するパターン名。他のタイプのものなら、この地図は隠れた状態で始まる */
  initialPatternName: string | undefined;
}

const { switchId, type, mapName, patterns, initialPatternName } = Astro.props;

const firstFloor = type.floors[0];
if (firstFloor === undefined) {
  throw new Error(`地図のタイプ「${type.id}」に階層が定義されていません`);
}

// 拡大しても地図の箱の大きさが変わらないよう、縦横比は画像の寸法から決める
const { width: mapWidth, height: mapHeight } = firstFloor.images.dark;

/** 地図画像の表示幅の候補。ダーク用とライト用で揃える */
const IMAGE_WIDTHS = [640, 1024, 1600, 2338];
// 地図は画面いっぱいに広がるため、画面幅を上限として見積もる
const IMAGE_SIZES = "100vw";

// ライトテーマ用は <source> に渡すため、あらかじめ srcset を組み立てておく
const lightSources = await Promise.all(
  type.floors.map(async (floor) =>
    floor.images.light === undefined
      ? undefined
      : await getImage({
          src: floor.images.light,
          widths: IMAGE_WIDTHS,
          format: "webp",
        }),
  ),
);
---

<div
  class="floor-switch"
  style={`--map-w: ${mapWidth}; --map-h: ${mapHeight};`}
  id={switchId}
  data-default-floor={type.defaultFloor}
  role="group"
  aria-label={`${mapName} の階層`}
>
  {
    type.floors.map((floor, floorIndex) => {
      const inputId = `${switchId}-${floor.id}`;
      const lightSource = lightSources[floorIndex];
      return (
        <>
          <input
            type="radio"
            name={switchId}
            id={inputId}
            class="floor-switch__input"
            data-floor-id={floor.id}
            checked={floor.id === type.defaultFloor}
          />
          <label for={inputId} class="floor-switch__label btn btn-outline">
            {floor.label}
          </label>
          <div class="floor-switch__panel">
            <div class="floor-switch__map">
              <div class="floor-switch__canvas">
                <picture>
                  {lightSource !== undefined && (
                    <source
                      srcset={lightSource.srcSet.attribute}
                      sizes={IMAGE_SIZES}
                      media="(prefers-color-scheme: light)"
                      width={mapWidth}
                      height={mapHeight}
                    />
                  )}
                  <Image
                    src={floor.images.dark}
                    alt={`${mapName} ${floor.label} の地図`}
                    widths={IMAGE_WIDTHS}
                    sizes={IMAGE_SIZES}
                    loading="eager"
                    draggable={false}
                  />
                </picture>
              </div>
              {patterns.map((pattern) => (
                <div
                  data-pattern-group={pattern.name}
                  hidden={pattern.name !== initialPatternName}
                >
                  {(pattern.itemsByFloorId[floor.id] ?? []).map((item) => (
                    <MapItemIcon
                      itemType={item.itemType}
                      placement={{
                        item,
                        mapWidth: floor.images.dark.width,
                        mapHeight: floor.images.dark.height,
                      }}
                    />
                  ))}
                </div>
              ))}
            </div>
          </div>
        </>
      );
    })
  }
</div>

<style>
  /* 地図は領域全体に重なるため、ここに流れるのは階層ボタンだけになる */
  .floor-switch {
    display: flex;
    flex-direction: column;
    align-items: start;
    gap: 0.5rem;
    padding: 0.5rem;
  }

  /* 見た目はラベルが担うため radio は隠すが、キーボード操作と読み上げには残す */
  .floor-switch__input {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  .floor-switch__label {
    min-width: 5rem;
    /* 地図は絶対配置で重なるため、ボタンを上に出す */
    position: relative;
    z-index: 1;
    /* 地図の上でも読めるよう、未選択でも背後を落とす */
    background-color: var(--map-overlay-bg);
    backdrop-filter: blur(2px);
  }

  .floor-switch__input:checked + .floor-switch__label {
    background-color: var(--color-primary);
    border-color: var(--color-primary);
    color: var(--color-primary-content);
  }

  .floor-switch__input:focus-visible + .floor-switch__label {
    outline: 2px solid var(--color-primary);
    outline-offset: 2px;
  }

  /* 地図を動かせる範囲。重ねたUIの下を通って拠点ページの領域いっぱいに広がる */
  .floor-switch__panel {
    display: none;
    position: absolute;
    inset: 0;
    /* 動かした地図が領域からはみ出さないようにする */
    overflow: hidden;
    /* ページがスクロールしないため、タッチは常に地図の操作に使う */
    touch-action: none;
    cursor: grab;
  }

  /* ドラッグ中かどうかは拠点単位で持つため、親の .map-view に付く */
  :global(.map-view.is-grabbing) .floor-switch__panel {
    cursor: grabbing;
  }

  /* 等倍のときの地図。領域に収まる最大の大きさにして中央に置く。
     幅と高さのどちらで頭打ちになっても縦横比を保てるよう、両辺を領域の大きさから直接求める。
     アイコンはこの箱を基準に置くため、拡大縮小の変形は内側のレイヤーにかける */
  .floor-switch__map {
    position: absolute;
    inset: 0;
    margin: auto;
    width: min(100cqw, 100cqh * var(--map-w) / var(--map-h));
    height: min(100cqh, 100cqw * var(--map-h) / var(--map-w));
  }

  /* 選択された階層の地図だけを表示する */
  .floor-switch__input:checked + .floor-switch__label + .floor-switch__panel {
    display: block;
  }

  /* 拡大縮小の対象。階層ごとの画像は個別に変形せずこのレイヤーに乗る */
  .floor-switch__canvas {
    width: 100%;
    height: 100%;
    transform-origin: 0 0;
    transform: translate(var(--pan-x, 0px), var(--pan-y, 0px))
      scale(var(--zoom, 1));
    /* 画像が読み込まれるまでの下地。画像はテーマごとに用意するので地の色に合わせる。
       地図と一緒に動くよう、枠ではなくこのレイヤーに置く */
    background-color: var(--color-base-200);
  }

  .floor-switch__canvas :global(picture),
  .floor-switch__canvas :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    /* 地図をドラッグして動かすため、画像自体のドラッグと選択を止める */
    user-select: none;
    -webkit-user-drag: none;
  }
</style>
