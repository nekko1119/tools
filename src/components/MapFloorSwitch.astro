---
import { getImage, Image } from "astro:assets";
import type { MapType } from "../types/nightreign-map";
import type { MapItemPattern } from "../types/nightreign-map-item";
import MapItemIcon from "./MapItemIcon.astro";

interface Props {
  /** radio のグループ名とidを一意にするための識別子 */
  switchId: string;
  type: MapType;
  /** 画像の alt の先頭に付ける名前。例: "大教会" */
  mapName: string;
  /** このタイプに属するアイテム配置パターン。未定義の拠点では空になる */
  patterns: readonly MapItemPattern[];
  /** 最初に表示するパターン名。他のタイプのものなら、この地図は隠れた状態で始まる */
  initialPatternName: string | undefined;
}

const { switchId, type, mapName, patterns, initialPatternName } = Astro.props;

const firstFloor = type.floors[0];
if (firstFloor === undefined) {
  throw new Error(`地図のタイプ「${type.id}」に階層が定義されていません`);
}

// 拡大しても枠の大きさが変わらないよう、表示領域は画像の寸法から縦横比を決める
const { width: mapWidth, height: mapHeight } = firstFloor.images.dark;

/** 地図画像の表示幅の候補。ダーク用とライト用で揃える */
const IMAGE_WIDTHS = [640, 1024, 1600, 2338];
const IMAGE_SIZES = "(min-width: 40rem) 60rem, 100vw";

// ライトテーマ用は <source> に渡すため、あらかじめ srcset を組み立てておく
const lightSources = await Promise.all(
  type.floors.map(async (floor) =>
    floor.images.light === undefined
      ? undefined
      : await getImage({
          src: floor.images.light,
          widths: IMAGE_WIDTHS,
          format: "webp",
        }),
  ),
);
---

<div
  class="floor-switch"
  style={`--floor-count: ${type.floors.length}; --map-w: ${mapWidth}; --map-h: ${mapHeight};`}
  id={switchId}
  data-default-floor={type.defaultFloor}
  role="group"
  aria-label={`${mapName} の階層`}
>
  {
    type.floors.map((floor, floorIndex) => {
      const inputId = `${switchId}-${floor.id}`;
      const lightSource = lightSources[floorIndex];
      return (
        <>
          <input
            type="radio"
            name={switchId}
            id={inputId}
            class="floor-switch__input"
            data-floor-id={floor.id}
            checked={floor.id === type.defaultFloor}
          />
          <label for={inputId} class="floor-switch__label btn btn-outline">
            {floor.label}
          </label>
          <div class="floor-switch__panel">
            <div class="floor-switch__canvas">
              <picture>
                {lightSource !== undefined && (
                  <source
                    srcset={lightSource.srcSet.attribute}
                    sizes={IMAGE_SIZES}
                    media="(prefers-color-scheme: light)"
                    width={mapWidth}
                    height={mapHeight}
                  />
                )}
                <Image
                  src={floor.images.dark}
                  alt={`${mapName} ${floor.label} の地図`}
                  widths={IMAGE_WIDTHS}
                  sizes={IMAGE_SIZES}
                  loading="eager"
                  draggable={false}
                />
              </picture>
            </div>
            {patterns.map((pattern) => (
              <div
                data-pattern-group={pattern.name}
                hidden={pattern.name !== initialPatternName}
              >
                {(pattern.itemsByFloorId[floor.id] ?? []).map((item) => (
                  <MapItemIcon
                    itemType={item.itemType}
                    placement={{
                      item,
                      mapWidth: floor.images.dark.width,
                      mapHeight: floor.images.dark.height,
                    }}
                  />
                ))}
              </div>
            ))}
            <div class="floor-switch__controls">
              <button
                type="button"
                class="btn btn-sm btn-neutral"
                data-zoom-action="in"
                aria-label="地図を拡大する"
              >
                +
              </button>
              <button
                type="button"
                class="btn btn-sm btn-neutral"
                data-zoom-action="out"
                aria-label="地図を縮小する"
              >
                −
              </button>
              <button
                type="button"
                class="btn btn-sm btn-neutral"
                data-zoom-action="reset"
              >
                リセット
              </button>
            </div>
          </div>
        </>
      );
    })
  }
</div>

<style>
  .floor-switch {
    display: grid;
    gap: 0.75rem;
    /* スマホでは階層ボタンを地図の上に横並びで置き、幅を均等に分ける */
    grid-template-columns: repeat(var(--floor-count), minmax(0, 1fr));
    /* 地図の表示領域の高さの上限 */
    --map-max-height: 70vh;
  }

  /* 見た目はラベルが担うため radio は隠すが、キーボード操作と読み上げには残す */
  .floor-switch__input {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  .floor-switch__label {
    order: 1;
  }

  .floor-switch__input:checked + .floor-switch__label {
    background-color: var(--color-primary);
    border-color: var(--color-primary);
    color: var(--color-primary-content);
  }

  .floor-switch__input:focus-visible + .floor-switch__label {
    outline: 2px solid var(--color-primary);
    outline-offset: 2px;
  }

  .floor-switch__panel {
    display: none;
    order: 2;
    grid-column: 1 / -1;
    position: relative;
    /* 拡大した地図が枠からはみ出さないようにする */
    overflow: hidden;
    aspect-ratio: var(--map-w) / var(--map-h);
    /* 縦に低い画面で地図全体を見るのに縦スクロールが要らないよう高さを抑える。
       高さで頭打ちになったときは、縦横比を保つため幅も合わせて縮め、中央に寄せる */
    width: 100%;
    max-height: var(--map-max-height);
    max-width: calc(var(--map-max-height) * var(--map-w) / var(--map-h));
    margin-inline: auto;
    border-radius: var(--radius-box);
    /* 等倍のときはページの縦スクロールに任せる */
    touch-action: pan-y;
    /* 画像が読み込まれるまでの下地。画像はテーマごとに用意するので地の色に合わせる */
    background-color: var(--color-base-200);
  }

  /* 選択された階層の地図だけを表示する */
  .floor-switch__input:checked + .floor-switch__label + .floor-switch__panel {
    display: block;
  }

  /* 拡大縮小の対象。階層ごとの画像は個別に変形せずこのレイヤーに乗る */
  .floor-switch__canvas {
    width: 100%;
    height: 100%;
    transform-origin: 0 0;
    transform: translate(var(--pan-x, 0px), var(--pan-y, 0px))
      scale(var(--zoom, 1));
  }

  .floor-switch__canvas :global(picture),
  .floor-switch__canvas :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    /* 地図をドラッグして動かすため、画像自体のドラッグと選択を止める */
    user-select: none;
    -webkit-user-drag: none;
  }

  /* 拡大の状態は拠点単位で持つため、親の .map-view に付く */
  :global(.map-view.is-zoomed) .floor-switch__panel {
    /* 拡大中はタッチを地図の移動に使う */
    touch-action: none;
  }

  :global(.map-view.is-zoomed) .floor-switch__canvas {
    cursor: grab;
  }

  :global(.map-view.is-zoomed.is-grabbing) .floor-switch__canvas {
    cursor: grabbing;
  }

  .floor-switch__controls {
    position: absolute;
    right: 0.5rem;
    bottom: 0.5rem;
    display: flex;
    gap: 0.25rem;
    padding: 0.25rem;
    border-radius: var(--radius-field);
    /* 地図の線に紛れないよう、ボタンの背後を暗く落とす */
    background-color: color-mix(
      in oklab,
      var(--color-base-100) 70%,
      transparent
    );
    backdrop-filter: blur(2px);
    /* 地図の上に重ねるが、ドラッグの邪魔をしないようボタンの上だけ反応させる */
    pointer-events: none;
  }

  .floor-switch__controls > * {
    pointer-events: auto;
  }

  @media (width >= 40rem) {
    .floor-switch {
      grid-template-columns: auto minmax(0, 1fr);
      /* 末尾の 1fr が余白を吸収し、階層ボタンが縦に間延びしないようにする */
      grid-template-rows: repeat(var(--floor-count), auto) 1fr;
    }

    .floor-switch__label {
      grid-column: 1;
      min-width: 5rem;
    }

    .floor-switch__panel {
      grid-column: 2;
      grid-row: 1 / -1;
    }
  }
</style>
