---
import { Image } from "astro:assets";
import type { MapType } from "../types/nightreign-map";

interface Props {
  /** radio のグループ名とidを一意にするための識別子 */
  switchId: string;
  type: MapType;
  /** 画像の alt の先頭に付ける名前。例: "大教会" */
  mapName: string;
}

const { switchId, type, mapName } = Astro.props;

const firstFloor = type.floors[0];
if (firstFloor === undefined) {
  throw new Error(`地図のタイプ「${type.id}」に階層が定義されていません`);
}

// 拡大しても枠の大きさが変わらないよう、表示領域は画像の縦横比で固定する
const aspectRatio = `${firstFloor.images.dark.width} / ${firstFloor.images.dark.height}`;
---

<div
  class="floor-switch"
  style={`--floor-count: ${type.floors.length}; --map-aspect: ${aspectRatio};`}
  role="group"
  aria-label={`${mapName} の階層`}
>
  {
    type.floors.map((floor) => {
      const inputId = `${switchId}-${floor.id}`;
      return (
        <>
          <input
            type="radio"
            name={switchId}
            id={inputId}
            class="floor-switch__input"
            checked={floor.id === type.defaultFloor}
          />
          <label for={inputId} class="floor-switch__label btn btn-outline">
            {floor.label}
          </label>
          <div class="floor-switch__panel">
            <div class="floor-switch__canvas">
              <Image
                src={floor.images.dark}
                alt={`${mapName} ${floor.label} の地図`}
                widths={[640, 1024, 1600, 2338]}
                sizes="(min-width: 40rem) 60rem, 100vw"
                loading="eager"
                draggable={false}
              />
            </div>
            <div class="floor-switch__controls">
              <button
                type="button"
                class="btn btn-sm btn-neutral"
                data-zoom-action="in"
                aria-label="地図を拡大する"
              >
                +
              </button>
              <button
                type="button"
                class="btn btn-sm btn-neutral"
                data-zoom-action="out"
                aria-label="地図を縮小する"
              >
                −
              </button>
              <button
                type="button"
                class="btn btn-sm btn-neutral"
                data-zoom-action="reset"
              >
                リセット
              </button>
            </div>
          </div>
        </>
      );
    })
  }
</div>

<script src="../scripts/nightreign/map-zoom.ts"></script>

<style>
  .floor-switch {
    display: grid;
    gap: 0.75rem;
    /* スマホでは階層ボタンを地図の上に横並びで置き、幅を均等に分ける */
    grid-template-columns: repeat(var(--floor-count), minmax(0, 1fr));
  }

  /* 見た目はラベルが担うため radio は隠すが、キーボード操作と読み上げには残す */
  .floor-switch__input {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  .floor-switch__label {
    order: 1;
  }

  .floor-switch__input:checked + .floor-switch__label {
    background-color: var(--color-primary);
    border-color: var(--color-primary);
    color: var(--color-primary-content);
  }

  .floor-switch__input:focus-visible + .floor-switch__label {
    outline: 2px solid var(--color-primary);
    outline-offset: 2px;
  }

  .floor-switch__panel {
    display: none;
    order: 2;
    grid-column: 1 / -1;
    position: relative;
    /* 拡大した地図が枠からはみ出さないようにする */
    overflow: hidden;
    aspect-ratio: var(--map-aspect);
    border-radius: var(--radius-box);
    /* JavaScript が読み込まれるまではページの縦スクロールを妨げない */
    touch-action: pan-y;
    /* TODO: ライトテーマ用の地図画像が用意できたら削除する。
       それまではライトテーマで黒背景の画像が浮かないよう暗い背景を敷く */
    background-color: var(--color-neutral);
  }

  /* 選択された階層の地図だけを表示する */
  .floor-switch__input:checked + .floor-switch__label + .floor-switch__panel {
    display: block;
  }

  /* 拡大縮小の対象。階層ごとの画像は個別に変形せずこのレイヤーに乗る */
  .floor-switch__canvas {
    width: 100%;
    height: 100%;
    transform-origin: 0 0;
    transform: translate(var(--pan-x, 0px), var(--pan-y, 0px))
      scale(var(--zoom, 1));
  }

  .floor-switch__canvas :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    /* 地図をドラッグして動かすため、画像自体のドラッグと選択を止める */
    user-select: none;
    -webkit-user-drag: none;
  }

  .floor-switch.is-zoomed .floor-switch__canvas {
    cursor: grab;
  }

  .floor-switch.is-zoomed.is-grabbing .floor-switch__canvas {
    cursor: grabbing;
  }

  .floor-switch__controls {
    position: absolute;
    right: 0.5rem;
    bottom: 0.5rem;
    display: flex;
    gap: 0.25rem;
    padding: 0.25rem;
    border-radius: var(--radius-field);
    /* 地図の線に紛れないよう、ボタンの背後を暗く落とす */
    background-color: color-mix(
      in oklab,
      var(--color-base-100) 70%,
      transparent
    );
    backdrop-filter: blur(2px);
    /* 地図の上に重ねるが、ドラッグの邪魔をしないようボタンの上だけ反応させる */
    pointer-events: none;
  }

  .floor-switch__controls > * {
    pointer-events: auto;
  }

  @media (width >= 40rem) {
    .floor-switch {
      grid-template-columns: auto minmax(0, 1fr);
      /* 末尾の 1fr が余白を吸収し、階層ボタンが縦に間延びしないようにする */
      grid-template-rows: repeat(var(--floor-count), auto) 1fr;
    }

    .floor-switch__label {
      grid-column: 1;
      min-width: 5rem;
    }

    .floor-switch__panel {
      grid-column: 2;
      grid-row: 1 / -1;
    }
  }
</style>
