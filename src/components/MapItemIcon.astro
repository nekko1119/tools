---
// 内側の塗りを --chest-fill で受け取る線画。
// CSS 変数を効かせるためインラインで展開する(img 要素では効かない)
import ChestIcon from "../assets/map-items/chest.svg";
import CorpseIcon from "../assets/map-items/corpse.svg";
import type { MapItem, MapItemType } from "../types/nightreign-map-item";

interface Props {
  item: MapItem;
  itemType: MapItemType;
  /** 座標の基準になる地図画像の原寸 */
  mapWidth: number;
  mapHeight: number;
}

const { item, itemType, mapWidth, mapHeight } = Astro.props;

/** アイコンの短辺の表示サイズ */
const ICON_SHORT_SIDE = 16;

/** 元の比率を保ったまま、短辺が指定の大きさになる寸法を求める */
function fitToShortSide(
  width: number,
  height: number,
): { width: number; height: number } {
  const scale = ICON_SHORT_SIDE / Math.min(width, height);
  return {
    width: Math.round(width * scale),
    height: Math.round(height * scale),
  };
}

// 地図の拡大率と表示位置に追従させるため、座標は画像に対する割合で渡す
const positionStyle = `--item-x: ${item.x / mapWidth}; --item-y: ${item.y / mapHeight};`;

const { appearance } = itemType;
// Astro でコンポーネントとして展開するため大文字で始める
const Icon = appearance.kind === "chest" ? ChestIcon : CorpseIcon;
const size = fitToShortSide(Icon.width, Icon.height);
const style =
  appearance.kind === "chest"
    ? `${positionStyle} --chest-fill: ${appearance.fillColor};`
    : positionStyle;
---

<Icon
  class="map-item-icon"
  style={style}
  width={size.width}
  height={size.height}
  role="img"
  aria-label={itemType.label}
/>

<style>
  .map-item-icon {
    position: absolute;
    /* 地図の拡大率と表示位置を座標にだけ反映し、アイコン自体は拡大しない */
    left: calc(var(--pan-x, 0px) + var(--item-x) * 100% * var(--zoom, 1));
    top: calc(var(--pan-y, 0px) + var(--item-y) * 100% * var(--zoom, 1));
    /* 座標がアイコンの中心を指すようにする */
    translate: -50% -50%;
    user-select: none;
    -webkit-user-drag: none;
  }
</style>
