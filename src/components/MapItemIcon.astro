---
import type { MapItem, MapItemType } from "../types/nightreign-map-item";

interface Props {
  itemType: MapItemType;
  /** 地図に重ねるときの位置。省略すると流し込みで並ぶ(凡例など) */
  placement?: {
    item: MapItem;
    /** 座標の基準になる地図画像の原寸 */
    mapWidth: number;
    mapHeight: number;
  };
}

const { itemType, placement } = Astro.props;

/** アイコンの短辺の表示サイズ。種別ごとに変えられる */
const DEFAULT_ICON_SHORT_SIDE = 32;

/** 元の比率を保ったまま、短辺が指定の大きさになる寸法を求める */
function fitToShortSide(
  width: number,
  height: number,
  shortSide: number,
): { width: number; height: number } {
  const scale = shortSide / Math.min(width, height);
  return {
    width: Math.round(width * scale),
    height: Math.round(height * scale),
  };
}

// 線画は CSS 変数で塗り色を受け取るため、インラインで展開する(img 要素では効かない)
const Icon = itemType.icon;
const size = fitToShortSide(
  Icon.width,
  Icon.height,
  itemType.iconShortSide ?? DEFAULT_ICON_SHORT_SIDE,
);

const styles: string[] = [];
if (itemType.fillColor !== undefined) {
  styles.push(`--icon-fill: ${itemType.fillColor};`);
}
if (placement !== undefined) {
  // 地図の拡大率と表示位置に追従させるため、座標は画像に対する割合で渡す
  const { item, mapWidth, mapHeight } = placement;
  styles.push(
    `--item-x: ${item.x / mapWidth}; --item-y: ${item.y / mapHeight};`,
  );
}
---

<Icon
  class:list={[
    "map-item-icon",
    placement !== undefined && "map-item-icon--placed",
  ]}
  style={styles.join(" ")}
  width={size.width}
  height={size.height}
  role="img"
  aria-label={itemType.label}
/>

<style>
  .map-item-icon {
    user-select: none;
    -webkit-user-drag: none;
  }

  .map-item-icon--placed {
    position: absolute;
    /* 地図の拡大率と表示位置を座標にだけ反映し、アイコン自体は拡大しない */
    left: calc(var(--pan-x, 0px) + var(--item-x) * 100% * var(--zoom, 1));
    top: calc(var(--pan-y, 0px) + var(--item-y) * 100% * var(--zoom, 1));
    /* 座標がアイコンの中心を指すようにする */
    translate: -50% -50%;
  }
</style>
